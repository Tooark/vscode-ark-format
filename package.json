{
  "name": "vscode-ark-format",
  "description": "Ark Format VS Code extensions monorepo (Shell, PowerShell e Makefile).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tooark/vscode-ark-format.git"
  },
  "homepage": "https://github.com/Tooark/vscode-ark-format",
  "bugs": {
    "url": "https://github.com/Tooark/vscode-ark-format/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/paulosfjunior"
  },
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build": "pnpm -r --if-present --workspace-concurrency=1 build",
    "watch": "pnpm -r --parallel --if-present watch",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "package": "pnpm -r --if-present package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.137.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
